# Leave as /api. Vite (dev) and Vercel (production) forward it to the backend,
# so the site never depends on an IP address.
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Optional, for testing the phone QR in local dev: set this to a tunnel address.
# In production the QR uses the site's own address automatically.
VITE_PUBLIC_APP_URL=
