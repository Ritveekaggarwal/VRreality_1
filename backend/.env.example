NODE_ENV=development
PORT=5000

MONGO_URI=your_mongodb_connection_string
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=at_least_32_random_characters

AI_SERVER_URL=http://127.0.0.1:8000
# Shared secret. Must match AI_SERVICE_TOKEN in ai/.env.
AI_SERVICE_TOKEN=

# Google sign-in. Must equal VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_AUTH_CLIENT_ID=your_google_client_id

# AI teacher. Without these, lessons fall back to the written script.
TAVUS_API_KEY=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=

# Email codes: brevo (recommended), gmail, console (prints codes, dev only), none.
# Defaults to console in development and none in production.
EMAIL_PROVIDER=console
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=VReality
BREVO_API_KEY=

# Only for EMAIL_PROVIDER=gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER=

# Only if the browser calls this API directly from another origin.
FRONTEND_URL=
